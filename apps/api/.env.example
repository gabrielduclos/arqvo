PORT=10000
NODE_ENV=development
# Exclusive Neon Arqvo connection. NEVER use Uorqui credentials.
DATABASE_URL=
# Disabled until Resend's sending domain is verified and integration tests pass.
AUTH_ENABLED=false
# Requires separate explicit approval for public registration.
AUTH_PUBLIC_SIGNUP=false
BETTER_AUTH_URL=https://arqvo.uorqui1.workers.dev
# >= 32 random bytes; must be a Render secret, never public.
BETTER_AUTH_SECRET=
# Dedicated or authorized Resend API key; never exposed to Cloudflare frontend.
RESEND_API_KEY=
# Email on a domain verified in the Resend account.
RESEND_FROM_EMAIL=arqvo@uorqui.app
